# region gitignore-sync
# stacks: vscode, intellij, macos, windows, linux
# ─────────────────────────────────────────

# region vscode@v1
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/mcp.json
# endregion

# region intellij@v1
.idea/*
# endregion

# region macos@v1
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
*.icloud
# endregion

# region windows@v1
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk
# endregion

# region linux@v1
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*
# endregion

# endregion

# Rescued from the generated block that was cut: these exist in the
# working tree and no managed block covers them.
node_modules
